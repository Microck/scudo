<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="scudo"
        Width="1480"
        Height="900"
        MinWidth="1260"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="6"
                            CaptionHeight="44"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BgMainBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentDangerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDangerHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDangerPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgMainBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgMainBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
            <Setter Property="Padding" Value="16,15" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="InsetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgMainBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="BodyCopyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionCaptionStyle}">
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="ControlCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgMainBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid x:Name="TitleBarDragZone">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <TextBlock Text="scudo"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="  "
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="windows 11 hardening"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <Border x:Name="SessionBadge"
                            Grid.Column="1"
                            Margin="0,8,10,8"
                            Padding="10,4"
                            CornerRadius="999"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SessionBadgeText"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Button x:Name="MinimizeButton"
                            Grid.Column="2"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="_" />
                    <Button x:Name="CloseButton"
                            Grid.Column="3"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="X" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="24,22,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Windows 11 hardening control center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Review state, understand the tradeoffs, and apply controls from one restrained surface."
                                   Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                        <Button x:Name="ExportReportButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="Export report"
                                Margin="0,0,10,0" />
                        <Button x:Name="OpenReportsButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="Open reports"
                                Margin="0,0,10,0" />
                        <Button x:Name="OpenCliButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="Open CLI" />
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="1"
                             Columns="4"
                             Margin="0,18,0,0">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="configured"
                                       Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="ConfiguredCountText"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="needs action"
                                       Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="NeedsActionCountText"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="reboot pending"
                                       Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="RebootCountText"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusRebootBrush}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="guidance"
                                       Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="GuidanceCountText"
                                       Grid.Row="1"
                                       Margin="0,10,0,0"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="0.92*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource PanelCardStyle}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="catalog filters"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Keep common decisions visible. Push narrow filtering one step down."
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Button x:Name="RefreshStatusButton"
                                        Grid.Column="1"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Refresh status"
                                        MinWidth="132"
                                        Height="40"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Search"
                                               Style="{StaticResource FilterLabelStyle}" />
                                    <TextBox x:Name="SearchTextBox"
                                             Style="{StaticResource FilterTextBoxStyle}"
                                             Height="40"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Search controls" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Section"
                                               Style="{StaticResource FilterLabelStyle}" />
                                    <ComboBox x:Name="SectionComboBox"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Height="40"
                                              VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Track"
                                               Style="{StaticResource FilterLabelStyle}" />
                                    <ComboBox x:Name="TrackComboBox"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Height="40"
                                              VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource PanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="control catalog"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="ControlCountText"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="10,6"
                                        CornerRadius="999"
                                        Background="{DynamicResource BgMainBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Select a control to inspect details"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ControlListPanel" />
                                </ScrollViewer>
                                <TextBlock x:Name="EmptyStateText"
                                           Text="No controls match the current filters."
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2"
                        Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="DetailTitleText"
                                       Text="Select a control"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="DetailMetaText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <Border x:Name="DetailStateBadge"
                                    Width="152"
                                    Margin="0,16,0,0"
                                    Padding="12,6"
                                    CornerRadius="999">
                                <TextBlock x:Name="DetailStateText"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource BgMainBrush}" />
                            </Border>
                            <TextBlock x:Name="DetailSummaryText"
                                       Margin="0,14,0,0"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="23" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,22,0,18"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource InsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="what it does"
                                                   Style="{StaticResource SectionCaptionStyle}" />
                                        <TextBlock x:Name="WhatItDoesText"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource BodyCopyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="why apply it"
                                                   Style="{StaticResource SectionCaptionStyle}" />
                                        <TextBlock x:Name="WhyApplyText"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource BodyCopyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="why skip it"
                                                   Style="{StaticResource SectionCaptionStyle}" />
                                        <TextBlock x:Name="WhySkipText"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource BodyCopyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="rollback"
                                                   Style="{StaticResource SectionCaptionStyle}" />
                                        <TextBlock x:Name="RollbackNoteText"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource BodyCopyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InsetCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="status notes"
                                                   Style="{StaticResource SectionCaptionStyle}" />
                                        <TextBlock x:Name="StatusNotesText"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource BodyCopyStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="RefreshSelectedButton"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Refresh"
                                    Height="42" />
                            <Button x:Name="ApplyButton"
                                    Grid.Column="2"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Apply"
                                    Height="42" />
                            <Button x:Name="RollbackButton"
                                    Grid.Column="4"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Rollback"
                                    Height="42" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14">
                <TextBlock x:Name="StatusBarText"
                           Margin="18,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Ready." />
            </Border>
        </Grid>
    </Border>
</Window>
