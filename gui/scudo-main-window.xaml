<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="scudo"
        MinWidth="1100"
        MinHeight="720"
        Width="1296"
        Height="836"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="5"
                            CaptionHeight="32"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDangerBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSurfaceSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BgMainBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentDangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDangerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDangerBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDangerPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDangerPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostActionStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder"
                                        Property="Background"
                                        Value="{DynamicResource BgSurfaceSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="10,0,8,0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   Text="{Binding SelectedItem.Title, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=''}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Background="{DynamicResource BgSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}">
                            <TextBlock Text="{Binding Title}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource BgSurfaceSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource BgSurfaceSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SectionCopyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DetailSectionStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,16,0,16" />
        </Style>

        <Style x:Key="DetailSectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DetailBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ControlRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgMainBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  x:Name="TitleBarDragZone"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="SCUDO"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <Border x:Name="SessionBadge"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Padding="8,3"
                        CornerRadius="3">
                    <TextBlock x:Name="SessionBadgeText"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BgMainBrush}" />
                </Border>

                <Button x:Name="MinimizeButton"
                        Grid.Column="2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource TitleBarButton}" />
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Style="{StaticResource CloseButtonStyle}" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="18,10,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Border Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CONFIGURED"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="ConfiguredCountText"
                                       Text="--"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource StatusConfiguredBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Text="NEEDS ACTION"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="NeedsActionCountText"
                                       Text="--"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource StatusActionBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Text="REBOOT REQ."
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="RebootCountText"
                                       Text="--"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource StatusRebootBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusCardStyle}">
                        <StackPanel>
                            <TextBlock Text="GUIDANCE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock x:Name="GuidanceCountText"
                                       Text="--"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource StatusAdvisoryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="20,4,0,0"
                            VerticalAlignment="Top">
                    <TextBlock Text="Scudo Hardening"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Inspect state, read the rationale, and apply only the controls you actually want."
                               Margin="0,5,0,0"
                               FontSize="12.5"
                               Style="{StaticResource SectionCopyStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="432" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,14">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Security Controls"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <Button x:Name="RefreshStatusButton"
                                    HorizontalAlignment="Right"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE72C;"
                                    Style="{StaticResource ActionButtonStyle}" />
                        </Grid>

                        <TextBlock Text="Filter the catalog, inspect the rationale, and apply only what you intend."
                                   Margin="0,0,0,12"
                                   Style="{StaticResource SectionCopyStyle}" />

                        <TextBox x:Name="SearchTextBox"
                                 Height="34"
                                 Margin="0,0,0,10"
                                 Style="{StaticResource SearchTextBoxStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SectionComboBox"
                                      Grid.Column="0"
                                      Height="34"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                            <ComboBox x:Name="TrackComboBox"
                                      Grid.Column="2"
                                      Height="34"
                                      Style="{StaticResource FilterComboBoxStyle}" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0"
                            Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONTROL NAME"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="STATUS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,4,4">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ControlListPanel"
                                            Margin="0" />
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyStateText"
                                       Text="No controls found matching filters."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3"
                               x:Name="ControlCountText"
                               Margin="0,10,10,8"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>

                <Border Grid.Column="2"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitleText"
                                       Text="Select a control to view details"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,18">
                                <TextBlock x:Name="DetailMetaText"
                                           Text="Section: N/A | Track: N/A"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <Border x:Name="DetailStateBadge"
                                        Margin="14,0,0,0"
                                        Background="{DynamicResource StatusUnsupportedBrush}"
                                        CornerRadius="3"
                                        Padding="8,3">
                                    <TextBlock x:Name="DetailStateText"
                                               Text="UNKNOWN"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BgMainBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="DetailSummaryText"
                                       Text="Detailed information about the selected security control will appear here."
                                       Margin="0,0,0,28"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource DetailBodyStyle}" />

                            <StackPanel>
                                <Border Style="{StaticResource DetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="WHAT IT DOES"
                                                   Style="{StaticResource DetailSectionHeadingStyle}" />
                                        <TextBlock x:Name="WhatItDoesText"
                                                   Text="-"
                                                   Style="{StaticResource DetailBodyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="WHY APPLY IT"
                                                   Style="{StaticResource DetailSectionHeadingStyle}" />
                                        <TextBlock x:Name="WhyApplyText"
                                                   Text="-"
                                                   Style="{StaticResource DetailBodyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="POTENTIAL DOWNSIDES"
                                                   Style="{StaticResource DetailSectionHeadingStyle}" />
                                        <TextBlock x:Name="WhySkipText"
                                                   Text="-"
                                                   Style="{StaticResource DetailBodyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ROLLBACK"
                                                   Style="{StaticResource DetailSectionHeadingStyle}" />
                                        <TextBlock x:Name="RollbackNoteText"
                                                   Text="-"
                                                   Style="{StaticResource DetailBodyStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailSectionStyle}"
                                        Padding="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="STATUS NOTES"
                                                   Style="{StaticResource DetailSectionHeadingStyle}" />
                                        <TextBlock x:Name="StatusNotesText"
                                                   Text="-"
                                                   FontStyle="Italic"
                                                   Style="{StaticResource DetailBodyStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenCliButton"
                                Content="Open CLI"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button x:Name="OpenReportsButton"
                                Content="Reports"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button x:Name="ExportReportButton"
                                Content="Export"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="StatusBarText"
                               Text="Ready"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="RefreshSelectedButton"
                                Content="Refresh"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button x:Name="RollbackButton"
                                Content="Rollback"
                                Margin="0,0,8,0"
                                Style="{StaticResource DangerButtonStyle}" />
                        <Button x:Name="ApplyButton"
                                Content="Apply Changes"
                                Width="120"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
